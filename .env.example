# Скопируйте этот файл в .env и заполните своими значениями.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789
# Юзернейм бота без @ (например eattomeat_bot) - нужен для диплинков
# t.me/USERNAME?startapp=recipe_42 (кнопка "Поделиться" на экране рецепта).
BOT_USERNAME=

# Прокси для подключения БОТА к Telegram API — заполняйте, только если
# провайдер блокирует/режет api.telegram.org напрямую (проверить:
# Test-NetConnection api.telegram.org -Port 443 в PowerShell).
# Формат — полный URL со схемой: http://логин:пароль@хост:порт
# или socks5://логин:пароль@хост:порт (какая именно схема — уточните у
# продавца прокси; если http:// не работает, попробуйте socks5://).
# Если оставить пустым — бот подключается напрямую, без прокси.
PROXY_URL=

# HTTPS-адрес, на котором развёрнут backend (он же раздаёт папку webapp/).
# Telegram НЕ откроет Mini App по http — нужен именно https.
# Для локальной проверки можно временно пробросить порт через ngrok/cloudflared
# и подставить сюда полученный https-адрес.
WEBAPP_URL=https://your-domain.example.com/

# true — разрешить открывать API без проверки подписи Telegram (только для
# локальной разработки в браузере, где нет initData). На проде — false.
DEV_MODE=false

# Ключи для ИИ-генерации рецептов (backend/ai_recipe.py). Нужен хотя бы один,
# но лучше все пять — тогда, если у одного провайдера кончится дневной
# бесплатный лимит, бот автоматически переключится на следующего.
# Gemini (основной): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (~1 млн токенов/день, без карты): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (бесплатные модели, без карты): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NVIDIA NIM (пробные кредиты, без карты): https://build.nvidia.com
NVIDIA_API_KEY=

# Поиск настоящего рецепта в интернете по названию блюда, вместо того чтобы
# ИИ придумывал его по памяти (backend/recipe_import.py). Бесплатно 1000
# запросов/мес без карты: https://app.tavily.com (можно оставить пустым -
# тогда используется ограниченный бесплатный доступ без регистрации).
TAVILY_API_KEY=

# Поиск настоящих фотографий блюд в свободных источниках для рецептов без
# фото (scripts/generate_recipe_images.py). Бесплатно без карты:
# https://www.pexels.com/api (можно оставить пустым - тогда используется
# только Openverse, ключ для него не нужен вообще).
PEXELS_API_KEY=

# Google Custom Search JSON API (поиск картинок) - см. backend/photo_search.py.
# API-ключ: Google Cloud Console -> APIs & Services -> Credentials.
# CX: https://programmablesearchengine.google.com/ - id созданной поисковой
# системы (Basics -> Search engine ID). Можно оставить пустым - тогда этот
# источник просто пропускается.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Разрешённые источники для CORS (через запятую). Если backend и webapp на
# одном домене (как в этом проекте по умолчанию) — можно оставить *.
CORS_ORIGINS=*
